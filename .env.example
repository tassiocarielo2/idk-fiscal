# Supabase — projeto IDK Fiscal
# Pegue em: https://supabase.com/dashboard/project/vejpzbqsysxbfpqpkbto/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Apenas server-side. NUNCA exponha no client.
SUPABASE_SERVICE_ROLE_KEY=

# Personal Access Token do Supabase — usado pelo MCP server (.mcp.json).
# Gere em: https://supabase.com/dashboard/account/tokens
# Defina no shell antes de iniciar o Claude Code:
#   PowerShell: $env:SUPABASE_ACCESS_TOKEN="sbp_..."
#   bash:       export SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_ACCESS_TOKEN=
